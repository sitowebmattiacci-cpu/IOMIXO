# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database (PostgreSQL) ────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/mashfusion

# ── Stripe ───────────────────────────────────────────────
# In TEST mode use sk_test_... and the webhook secret from `stripe listen` (or Test Dashboard endpoint).
# In LIVE mode swap to sk_live_..., the live whsec_... from the Live Dashboard endpoint, and live price IDs.
# Same env var names — different deploy environment loads test vs live values.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Multi-currency Price IDs (EUR for it/fr/es · USD for en). The webhook maps any
# of these to the right plan tier, so list every currency you create.
STRIPE_PRICE_PRO_MONTHLY_EUR=price_...       # Pro     €9,99/mo
STRIPE_PRICE_PRO_MONTHLY_USD=price_...       # Pro     $9.99/mo
STRIPE_PRICE_WEDDING_MONTHLY_EUR=price_...   # Advance €19,99/mo
STRIPE_PRICE_WEDDING_MONTHLY_USD=price_...   # Advance $19.99/mo
STRIPE_PRICE_EVENT_PASS_EUR=price_...        # Event Pass 24H €7,99 (one-time)
STRIPE_PRICE_EVENT_PASS_USD=price_...        # Event Pass 24H $7.99 (one-time)

# ── CORS ─────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── App URL (used in Stripe redirects) ───────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── SMTP (Email) ─────────────────────────────────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=IOMIXO <noreply@iomixo.com>

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=debug
