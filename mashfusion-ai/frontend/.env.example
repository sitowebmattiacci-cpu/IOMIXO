# ── API Backend URL ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Stripe (public price IDs) ────────────────────────────
# Multi-currency: EUR for it/fr/es locales, USD for en locale.
# Use TEST price IDs in dev/staging, LIVE price IDs in production deployments.
# Must match the prices configured on the backend.
#
# Subscriptions — Pro plan (€9,99 / $9.99 per month)
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID_EUR=price_...
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID_USD=price_...
# Subscriptions — Advance/Wedding plan (€19,99 / $19.99 per month)
NEXT_PUBLIC_STRIPE_WEDDING_PRICE_ID_EUR=price_...
NEXT_PUBLIC_STRIPE_WEDDING_PRICE_ID_USD=price_...
# One-time — Event Pass 24H (€7,99 / $7.99)
NEXT_PUBLIC_STRIPE_PRICE_EVENT_PASS_EUR=price_...
NEXT_PUBLIC_STRIPE_PRICE_EVENT_PASS_USD=price_...

# Legacy single-currency fallbacks (optional — used if the *_EUR/*_USD vars above are unset)
# NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...
# NEXT_PUBLIC_STRIPE_WEDDING_PRICE_ID=price_...
# NEXT_PUBLIC_STRIPE_PRICE_EVENT_PASS=price_...

# ── Firebase (migration in progress — not used by the app yet) ──
# Leave empty until the real project exists. For local emulators set USE_EMULATORS=true.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# App Check (public site key from the reCAPTCHA key you register in the console; leave empty to disable)
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
NEXT_PUBLIC_FIREBASE_APPCHECK_PROVIDER=enterprise   # enterprise | v3
# Local debug only (honoured on localhost only). Put it in .env.local, NEVER commit it.
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Which auth the app uses when Firebase is configured: 'supabase' keeps the legacy provider (Firebase stays dormant),
# 'firebase' (or unset) switches to Firebase Auth. Emulator runs (npm run dev:emulators) always use Firebase.
NEXT_PUBLIC_AUTH_PROVIDER=supabase
