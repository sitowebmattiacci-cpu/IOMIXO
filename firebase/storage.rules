rules_version = '2';
// Event photos. Least privilege: everything is closed except the two paths below. Cross-service rules read Firestore (events, photos).
//
//   events/{eventId}/photos/{photoId}/original.{jpg|jpeg|png|webp|mp4|mov|webm}   guest album + Live Booth: the ORIGINAL, exactly as sent
//   events/{eventId}/photos/{photoId}/optimized.jpg | thumb.jpg      what the album / TV show for a photo (1920 px JPEG) and its thumbnail / video poster
//   events/{eventId}/exports/...                                      album ZIP built by a Function: closed to every client (the owner gets a short-lived URL from a callable)
//   events/{eventId}/winner/{groom|bride}-<random>.{ext}             winner-announcement photos (owner)
//   profiles/{uid}/avatar/{user|dj}-<random>.{jpg|png|webp}          profile avatars (owner only, ≤5 MB; committed by the commitAvatar callable)
//
// Never listable. No client may overwrite or delete anything: removals / token rotation / cleanup are done by Cloud Functions (Admin SDK).
// The Firestore photo doc is created by the createPhotoUpload callable (event live + plan + anti-spam) BEFORE the bytes: the write is accepted only
// for the exact path(s) written in that doc, by the guest it was issued to, once, with the declared type and at most `maxBytes` (a server decision:
// 8 MB for a legacy single-file photo, 50 MB for an original photo, 150 MB for a video; derivatives are capped here).
// Reading: the OWNER reads everything. Guests / the TV read only APPROVED media, and only what they need to SHOW it: the optimized image and thumbnail,
// the video file itself (there is no transcoded copy to show instead) and, for legacy photos that never had an optimized copy, their single file.
// The ORIGINAL of a new photo is therefore not readable by guests.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAccount() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function event(eventId) { return firestore.get(/databases/(default)/documents/events/$(eventId)).data; }
    function isEventOwner(eventId) { return isAccount() && event(eventId).ownerUid == request.auth.uid; }
    // MIOLOVE album (same classification as firestore.rules isMioloveEvent): its media are readable by non-owners only while the owner keeps
    // guestConfig.shared_gallery on. Absent / false = closed (every album starts closed). Events that are not a MIOLOVE album are not affected.
    function isCoupleOwner(ev) {
      return firestore.exists(/databases/(default)/documents/users/$(ev.ownerUid))
        && firestore.get(/databases/(default)/documents/users/$(ev.ownerUid)).data.get('accountType', 'dj') == 'couple';
    }
    function isMioloveAlbum(ev) {
      return ev.get('brand', '') == 'miolove'
        || (ev.get('brand', '') == '' && ev.get('type', '') == 'wedding'
            && (ev.get('accessMode', '') in ['trial', 'pending', 'activated', 'purged'] || isCoupleOwner(ev)));
    }
    function galleryOpen(ev) {
      return !isMioloveAlbum(ev)
        || ('guestConfig' in ev && ev.guestConfig is map && ev.guestConfig.get('shared_gallery', false) == true);
    }
    function validImage() {
      return request.resource.size > 0 && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    function validDerivative(maxBytes) {
      return request.resource.size > 0 && request.resource.size <= maxBytes && request.resource.contentType == 'image/jpeg';
    }

    match /events/{eventId}/photos/{photoId}/{file} {
      function photo() { return firestore.get(/databases/(default)/documents/events/$(eventId)/photos/$(photoId)).data; }
      function path() { return 'events/' + eventId + '/photos/' + photoId + '/' + file; }
      // Server-chosen ceiling for the original (docs created before the media model carry none: the old 8 MB).
      function maxOriginal(ph) { return 'maxBytes' in ph ? ph.maxBytes : 8 * 1024 * 1024; }

      // Every Firestore document is read ONCE per request (the photo doc and the event doc are passed down as arguments): each firestore.get() is a
      // billed read in production and a round trip between emulators, so the rules never call photo() / event() twice.
      function canCreate(ph, ev) {
        return ph.status == 'uploading'
          && ph.guestUid == request.auth.uid
          && ev.status == 'live' && !('deletedAt' in ev)
          && (
            (file.matches('original\\.(jpg|jpeg|png|webp|mp4|mov|webm)')
              && ph.storagePath == path()
              && request.resource.contentType == ph.contentType
              && request.resource.size > 0 && request.resource.size <= maxOriginal(ph))
            || (file == 'optimized.jpg' && 'optimizedPath' in ph && ph.optimizedPath == path() && validDerivative(4 * 1024 * 1024))
            || (file == 'thumb.jpg' && 'thumbPath' in ph && ph.thumbPath == path() && validDerivative(1024 * 1024))
          );
      }
      // Guests / TV: approved media of a not-deleted event, and never the ORIGINAL of a photo that has an optimized copy.
      function guestCanRead(ph, ev) {
        return ph.status == 'approved' && !('deletedAt' in ev) && galleryOpen(ev)
          && (file == 'optimized.jpg' || file == 'thumb.jpg'
              || (file.matches('original\\..*')
                  && (('mediaType' in ph && ph.mediaType == 'video') || !('optimizedPath' in ph) || ph.optimizedPath == null)));
      }
      function canRead(ev) { return (isAccount() && ev.ownerUid == request.auth.uid) || guestCanRead(photo(), ev); }

      // `resource == null`: the object must not exist yet (an overwrite is an update, which is never allowed; stated explicitly for the emulator too).
      allow create: if signedIn() && resource == null && canCreate(photo(), event(eventId));
      // Read one file, never list. Owner: everything. Guests / TV: see guestCanRead.
      allow get: if signedIn() && canRead(event(eventId));
      allow list, update, delete: if false;
    }

    match /events/{eventId}/winner/{file} {
      allow create: if resource == null && isEventOwner(eventId) && !('deletedAt' in event(eventId))
        && file.matches('(groom|bride)-[A-Za-z0-9_-]{12,}\\.(jpg|jpeg|png|webp)')
        && validImage();
      // The TV (anonymous) shows these; the random file name is the capability, as the legacy 1 h signed URL was.
      allow get: if signedIn() && !('deletedAt' in event(eventId));
      allow list, update, delete: if false;
    }

    // Avatars: the owner creates a NEW random-named object (never an overwrite); the commitAvatar callable verifies it, publishes its download URL and
    // removes the replaced one; removeAvatar deletes. Reading the bytes goes through the tokenised URL stored in Firestore (the token is the capability, as
    // the legacy public bucket URL was), so the only direct read is the owner's.
    match /profiles/{uid}/avatar/{file} {
      allow create: if isAccount() && request.auth.uid == uid && resource == null
        && file.matches('(user|dj)-[A-Za-z0-9_-]{16,64}\\.(jpg|png|webp)')
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow get: if isAccount() && request.auth.uid == uid;
      allow list, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
