# Local/emulator values only. Real values: Firebase params + `firebase functions:secrets:set SUPABASE_SERVICE_ROLE_KEY`.
# TODO(firebase-migration): remove with the Supabase bridge.
# LEGACY_BRIDGE is REQUIRED (missing/unknown = fail closed, deploy and calls refuse to run):
#   mock     = no network at all, synthetic ids (cloud tests; no secret needed)
#   none     = Firestore only (end state)
#   supabase = explicit opt-in; needs SUPABASE_URL + secret SUPABASE_SERVICE_ROLE_KEY
LEGACY_BRIDGE=mock
SUPABASE_URL=http://127.0.0.1:54321
APPCHECK_ENFORCE_OWNER=false
APPCHECK_ENFORCE_PUBLIC_EVENT=false
APPCHECK_ENFORCE_PHOTO=false
