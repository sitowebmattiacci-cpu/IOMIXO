# Cloud (iomixo-494817) deploy values. Non-secret. mock = no network, no Supabase, no secret.
LEGACY_BRIDGE=mock
# App Check enforcement, one switch per callable (false = observe/log only). Roll back by setting false + redeploying THAT function.
APPCHECK_ENFORCE_VOTE=true
APPCHECK_ENFORCE_DEDICATION=true
APPCHECK_ENFORCE_REQUEST=true
# New callables (owner moderation/polls/settings, public event lookup): observe-only until App Check is verified on the web client, then flip to true.
APPCHECK_ENFORCE_OWNER=false
APPCHECK_ENFORCE_PUBLIC_EVENT=false
# Guest photo upload callables (createPhotoUpload / finalizePhoto): observe-only until verified on the web client.
APPCHECK_ENFORCE_PHOTO=false

# ── Billing (Stripe). Non-secret: price ids are public identifiers. Secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET) live in Secret Manager only. ──
APPCHECK_ENFORCE_BILLING=false
APP_BASE_URL=https://www.iomixo.com
# MIOLOVE portal (miolovealbum.com is connected to App Hosting): Sposi accounts return from Stripe Checkout / Billing Portal to it.
MIOLOVE_BASE_URL=https://miolovealbum.com
